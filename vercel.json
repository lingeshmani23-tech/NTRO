{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/analyze/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/analyze",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/analysis/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/analysis",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/demo",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
